# Redirections : tout vers https://avf-domotique.ch (une seule adresse, en HTTPS)
<IfModule mod_rewrite.c>
  RewriteEngine On
  # www.avf-domotique.ch -> avf-domotique.ch
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # http -> https (X-Forwarded-Proto : cas d'un proxy devant Apache)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Compression et cache (serveurs Apache)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  # Images de /assets : nom avec empreinte, donc cache long sans risque
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  # JPEG : aussi og-image.jpg, dont le nom ne change pas
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Page 404 générée par vite-ssg
ErrorDocument 404 /404/index.html

# En-têtes de sécurité de base
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
