{
  "name": "avf-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite-ssg build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src/ *.ts *.json *.md",
    "format:check": "prettier --check src/ *.ts *.json *.md"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@unhead/vue": "^2.1.17",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "beasties": "^0.3.5",
    "daisyui": "^5.7.50",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "vite": "^8.3.7",
    "vite-imagetools": "^12.0.1",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
